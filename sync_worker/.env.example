# Copy this file to .env and fill in your real values.
# Never commit .env with real passwords or database URLs.

# Required: local or live.
ENV_MODE=local

# Required when ENV_MODE=local.
LOCAL_ERP_HOST=DESKTOP-99CSEES
ERP_INSTANCE=RANCELAB2008

# Required when ENV_MODE=live.
ERP_HOST=
ERP_PORT=6161

# Required in both modes.
ERP_USER=
ERP_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Optional worker settings.
ERP_DATABASE=FR8RootDB
SYNC_INTERVAL=30
GYM_LOCATION_ID=15
MEMBERSHIP_GROUP_ID=107
TIMEZONE=Africa/Nairobi
LOG_LEVEL=INFO
