# Env vars for the erp_api Railway deployment — DEMO environment only.
# Placeholders only. Copy real values from .env.demo (repo root) into
# Railway's dashboard manually — never commit this file with real values,
# and never paste production's ynunbegchlyyfhdffsim credentials here.
#
# PORT is injected automatically by Railway — do not set it yourself.

# ── Supabase (the DEMO project — vjrwjqvycxzwxqmnilck, never production) ───
# Used for Auth Admin calls (contracts/staff) — from .env.demo's SUPABASE_URL / SUPABASE_SERVICE_KEY.
SUPABASE_URL=https://your-demo-project-ref.supabase.co
SUPABASE_SERVICE_KEY=paste-the-demo-projects-service-role-key-here

# Used for the actual Postgres connection (build_config().gym_conn_str) —
# from .env.demo's SUPABASE_DB_* fields. This is what demo_guard.py,
# business_settings.py, contracts.py, staff.py, wrap.py all actually query.
SUPABASE_DB_HOST=your-demo-project.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-demo-project-ref
SUPABASE_DB_PASSWORD=paste-the-demo-db-password-here

# ── ERP (SQL Server) — NOT actually reachable in the demo, on purpose ──────
# The demo has no real ERP behind it (static, pre-seeded Supabase data only —
# see demo/README.md). These four MUST still be set to non-empty values
# though: sync_worker/config.py's build_config() treats ERP_USER/ERP_PASSWORD
# as required regardless of mode, and if that call fails, demo_guard.py's
# self-expiry check silently fails open (never expires) rather than crash —
# so leaving these blank would quietly break the demo's whole self-expiry
# feature, not just ERP-facing endpoints. Any non-empty placeholder is fine;
# nothing here ever needs to successfully connect for the demo to work.
ENV_MODE=live
ERP_HOST=unused-demo-placeholder
ERP_PORT=6161
ERP_USER=unused
ERP_PASSWORD=unused
ERP_DATABASE=FR8RootDB

# ── CORS ─────────────────────────────────────────────────────────────────
# The deployed frontend's origin (Vercel demo domain). Comma-separate if
# there's more than one (e.g. a Vercel preview + production alias).
# localhost is always allowed in addition to this, for local testing.
FRONTEND_URL=https://your-demo-frontend.vercel.app
