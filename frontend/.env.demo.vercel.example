# Env vars for the frontend's Vercel deployment — DEMO environment only.
# Placeholders only. Copy real values from .env.demo (repo root) and the
# Railway erp_api deployment into Vercel's dashboard by hand — never commit
# this file with real values, and never paste production's
# ynunbegchlyyfhdffsim credentials here.
#
# This is the full env var list the frontend actually reads (lib/env.ts,
# lib/supabase.ts, lib/erp-client.ts + every app/api/**/route.ts) — matches
# frontend/.env.local (production) key-for-key, just pointed at the demo
# project instead.

# ── Supabase (the DEMO project — vjrwjqvycxzwxqmnilck, never production) ───
# Client + server: used by lib/supabase.ts, lib/env.ts, and middleware.ts's
# auth-session refresh. Public (NEXT_PUBLIC_*) by design — the anon key is
# meant to be exposed to the browser; RLS is what actually protects data.
# From .env.demo's SUPABASE_URL / SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://your-demo-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-the-demo-projects-anon-key-here

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser bundle).
# Used by lib/supabase.ts's supabaseAdmin, which every app/api/** route that
# needs to bypass RLS (or call demo_status_check()) goes through.
# From .env.demo's SUPABASE_SERVICE_KEY.
SUPABASE_SERVICE_ROLE_KEY=paste-the-demo-projects-service-role-key-here

# ── erp_api (Railway) ────────────────────────────────────────────────────
# Server-only (no NEXT_PUBLIC_ prefix, deliberately — the ERP is never
# called from the browser). The base URL that lib/erp-client.ts and every
# ERP-backed app/api/**/route.ts (pos/*, reports/*, wrap/*, staff/*,
# members/[id]/contract/*, email/*, analytics, public/leads — 27 files each
# read process.env.ERP_API_URL independently) proxy requests to. All 27
# fall back to http://localhost:8000 if unset (see "Known env-var gap" in
# VERCEL_DEPLOY.md) — so this MUST be set here, or the deployed app will
# silently try to reach a Vercel-side "localhost" that doesn't exist and
# every ERP-backed page will fail.
# Set this to the Railway erp_api service's public URL (see RAILWAY_DEPLOY.md
# step 6) — e.g. https://gymfit-demo-erp-api.up.railway.app
ERP_API_URL=https://your-demo-erp-api.up.railway.app
